{
  "vars": {
    "ORVEN_AUTH_ORIGIN": "https://orven-handoff.surtrcode.workers.dev",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "name": "orven-handoff",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orven-handoff-db",
      "database_id": "a04f73b5-7c42-4c33-bbe8-d423e29e4b1e",
      "migrations_dir": "migrations"
    }
  ]
}
