{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orven",
  "version": "0.2.0",
  "identifier": "dev.orven.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orven \u2014 Engineering Audit Workspace",
        "width": 1440,
        "height": 1000,
        "minWidth": 980,
        "minHeight": 680,
        "backgroundColor": "#f9f9f8",
        "theme": "Light",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "main-local",
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-bootstrap",
            "allow-register-project",
            "allow-select-project",
            "allow-list-runs",
            "allow-read-report",
            "allow-run-audit",
            "core:window:allow-start-dragging",
            "allow-gateway-snapshot",
            "allow-gateway-control",
            "allow-account-snapshot",
            "allow-account-begin",
            "allow-account-poll",
            "allow-account-cancel",
            "allow-account-logout"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
